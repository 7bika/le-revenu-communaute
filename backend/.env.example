# --- Serveur ---
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337

# --- Secrets : générez vos propres valeurs (voir README : `node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"`) ---
APP_KEYS=changeMe1,changeMe2,changeMe3,changeMe4
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
ENCRYPTION_KEY=changeMe

# --- PostgreSQL ---
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lerevenu
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# --- Application ---
# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000
# Crée les espaces, les membres et les discussions de démonstration au premier démarrage (base vide)
SEED_DEMO_DATA=true
# Mot de passe commun à tous les membres de démonstration
DEMO_USER_PASSWORD=Demo1234!

# Compte du back-office créé au premier démarrage (facultatif)
ADMIN_EMAIL=admin@lerevenu.local
ADMIN_PASSWORD=Admin1234!
