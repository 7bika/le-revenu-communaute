# URL de l'API Strapi, appelée uniquement côté serveur (Server Components et Server Actions)
STRAPI_URL=http://localhost:1337
# Affiche les comptes de démonstration sur la page de connexion
SHOW_DEMO_ACCOUNTS=true
# Mettre à false pour tester un build de production en HTTP simple (cookie de session sans Secure)
COOKIE_SECURE=true
